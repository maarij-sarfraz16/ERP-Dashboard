# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Every value here is read by the dashboard SERVER only. None of these names
# start with VITE_, which is what keeps them out of the browser bundle — do not
# rename them to VITE_* or the secrets ship to every visitor.


# ── Sign-in: the two fixed accounts ──────────────────────────────────────────
# There is no user table and no registration. These two entries are the whole
# account list.
#
# Generate each hash on your own machine with:
#
#     npm run hash-password
#
# It prompts with the echo turned off and prints only the bcrypt hash. Paste
# that hash below. Never put the plain password in this file or in `.env`.

AUTH_USER_1=ADMIN
AUTH_PASSWORD_HASH_1=$2b$12$MzuVru3gZkgzCILOU7y.u.w9nbdj7fbYWTYX1Fa.DUXEDTNoAwrme

AUTH_USER_2=saadsohail@atssynthetic.com.pk
AUTH_PASSWORD_HASH_2=$2b$12$iQKChd7Fz22sfB4TEnCdGuLzBQ3C3.qiAof9s4S5AMio./4U7MQR6

# Set to true ONLY when the dashboard is served over HTTPS. A Secure cookie is
# silently dropped over plain http://, which makes sign-in appear to succeed
# and then immediately fail.
AUTH_COOKIE_SECURE=false


# ── Frappe / ERPNext backend ─────────────────────────────────────────────────
# Read-only. The server attaches these to relayed requests; the browser never
# sees them. Generate the key/secret in Frappe under User → API Access →
# Generate Keys.

# Base URL of the Frappe site: protocol + host + port, no trailing slash.
FRAPPE_API_BASE_URL=http://<SERVER_IP>:<PORT>
FRAPPE_API_KEY=<api_key>
FRAPPE_API_SECRET=<api_secret>


# ── Production server (npm start) ────────────────────────────────────────────
PORT=5173
HOST=0.0.0.0
