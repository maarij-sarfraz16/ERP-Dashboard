# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
VITE_API_BASE_URL=http://<SERVER_IP>:<PORT>
VITE_FRAPPE_API_KEY=<api_key>
VITE_FRAPPE_API_SECRET=<api_secret>

# Dev-only CORS workaround; see vite.config.ts.
VITE_USE_DEV_PROXY=true

# Sign-in uses the Frappe `User` table. Set to false to remove the offline
# fallback account that works only when the Frappe server is unreachable.
VITE_ALLOW_LOCAL_LOGIN=true
